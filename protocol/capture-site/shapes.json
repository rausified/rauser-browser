  "reject": [
    {
      "note": "Uppercase literal",
      "shape": "/Title"
    },
    {
      "note": "Uppercase query name",
      "shape": "/a?Key={slug}"
    },
    {
      "note": "Digits outside a placeholder",
      "shape": "/items/123"
    },
    {
      "note": "Digit inside a literal",
      "shape": "/v2/{num}"
    },
    {
      "note": "21-character literal",
      "shape": "/xxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "note": "Two separators in one literal",
      "shape": "/a-b-c/{num}"
    },
    {
      "note": "Separator-only literal",
      "shape": "/-/{num}"
    },
    {
      "note": "Query value that is not a placeholder",
      "shape": "/a?key=secret"
    },
    {
      "note": "Query placeholder used as a value",
      "shape": "/a?{param}={param}"
    },
    {
      "note": "Second question mark",
      "shape": "/x?a=b?c"
    },
    {
      "note": "Second query after a valid one",
      "shape": "/a?key={slug}?x={num}"
    },
    {
      "note": "Empty query",
      "shape": "/a?"
    },
    {
      "note": "Trailing ampersand",
      "shape": "/a?b={num}&"
    },
    {
      "note": "Pair without a value",
      "shape": "/a?b"
    },
    {
      "note": "Pair with two equals signs",
      "shape": "/a?b={num}={num}"
    },
    {
      "note": "Fragment",
      "shape": "/a#{slug}"
    },
    {
      "note": "Unknown placeholder",
      "shape": "/{token}"
    },
    {
      "note": "Query-name placeholder in the path",
      "shape": "/{param}"
    },
    {
      "note": "Uppercase placeholder",
      "shape": "/{Num}"
    },
    {
      "note": "Unbalanced placeholder",
      "shape": "/{num"
    },
    {
      "note": "No leading slash",
      "shape": "a/{num}"
    },
    {
      "note": "Empty string",
      "shape": ""
    },
    {
      "note": "Non-ASCII literal",
      "shape": "/café"
    },
    {
      "note": "33 segments",
      "shape": {
        "$build": [
          {
            "repeat": "/a",
            "times": 33
          }
        ]
      }
    },
    {
      "note": "9 query pairs",
      "shape": {
        "$build": [
          "/a?",
          {
            "repeat": "b={num}&",
            "times": 8
          },
          "b={num}"
        ]
      }
    },
    {
      "note": "Over 2,048 characters",
      "shape": {
        "$build": [
          "/",
          {
            "repeat": "a",
            "times": 2048
          }
        ]
      }
    }
  ]
