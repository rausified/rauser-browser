      "note": "Private query names become {param} and pairs sort",
      "url": "https://work.example/route-word/_layouts/end_?customer=secret&privateKey=CustomerName&sort=ASC&page=42#TOP-SECRET",
      "shape": "/route-word/_layouts/end_?customer={slug}&page={num}&sort={slug}&{param}={slug}"
    },
    {
      "note": "A 20-character literal is the longest route word",
      "url": "https://wiki.example/aaaaaaaaaaaaaaaaaaaa/1",
      "shape": "/aaaaaaaaaaaaaaaaaaaa/{num}"
    },
    {
      "note": "32 segments is the limit",
      "url": {
        "$build": [
          "https://wiki.example",
          {
            "repeat": "/a",
            "times": 32
          }
        ]
      },
      "shape": {
        "$build": [
          {
            "repeat": "/a",
            "times": 32
          }
        ]
      }
    },
    {
      "note": "8 query pairs is the limit",
      "url": {
        "$build": [
          "https://wiki.example/a?",
          {
            "repeat": "b=1&",
            "times": 7
          },
          "b=1"
        ]
      },
      "shape": {
        "$build": [
          "/a?",
          {
            "repeat": "b={num}&",
            "times": 7
          },
          "b={num}"
        ]
      }
    }
