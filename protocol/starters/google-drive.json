  "types": [
    {
      "type": "google.drivefolder",
      "key": "google.drivefolder",
      "label": "Google Drive folders",
      "label_variants": [],
      "description": "Each Drive folder, including a shared-drive folder, becomes one artifact, keyed by its permanent folder ID, however it was opened or shared. Records folders from every Google account signed in to this Chrome profile.",
      "record_label": "folders",
      "example_path": null,
      "adapter": {
        "type": "google.drivefolder",
        "match": [
          {
            "path": "/drive/folders/{id:token(20,128)}"
          },
          {
            "path": "/drive/u/{_}/folders/{id:token(20,128)}"
          }
        ],
        "id": "google.drivefolder:{host}/{id}",
        "title": [
          "{title} - Google Drive",
          "{title} – Google Drive"
        ]
      },
      "history": [],
      "status": {
        "state": "development",
        "method": null,
        "checked_on": null,
        "checked_by": null
      },
