{
  "family": "github",
  "display_name": "GitHub",
  "review_prompt": "Choose the kinds of work to remember and the work organizations that own them. Only repositories, pull requests and issues owned by the names you enter are included. Leave personal accounts out.",
  "origin": { "kind": "exact", "origin": "https://github.com" },
  "scope": { "kind": "github_org" },
  "types": [
    {
      "type": "github.pr",
      "key": "github.pr",
      "label": "GitHub pull requests",
      "label_variants": [],
      "description": "Pull request routes share one artifact; files use review mode, while commits and checks use view mode.",
      "record_label": "pull requests",
      "example_path": "/{scope}/example-repository/pull/123",
      "adapter": {
        "type": "github.pr",
        "match": [{ "path": "/{owner:name|lower}/{repo:name|lower}/pull/{number:int}/{mode?:(files|commits|checks)}/{*}" }],
        "scope": { "owner": { "$scope": true } },
        "modes": { "files": "review", "commits": "view", "checks": "view" },
        "id": "github.pr:{host}/{owner}/{repo}/{number}",
        "title": "{title} by {~} · Pull Request #{number:int} · {owner:name}/{repo:name} · GitHub",
        "refs": [{ "type": "jira.issue", "find": "jira_key" }],
        "within": { "type": "github.repo", "id": "github.repo:{host}/{owner}/{repo}" }
      },
      "history": [],
      "status": { "state": "certified", "method": "live", "checked_on": "2026-11-02", "checked_by": "John" },
      "docs": "docs/adapters/github.pr.md",
      "samples": [
        {
          "note": "GitHub pull request overview",
          "url": "https://github.com/Acme/Widget/pull/42",
          "title": "Fix login by alice · Pull Request #42 · acme/widget · GitHub",
          "shape": "/{slug}/{slug}/pull/{num}"
        },
        {
          "note": "GitHub pull request files",
          "url": "https://github.com/acme/widget/pull/42/files",
          "title": null,
          "shape": "/acme/widget/pull/{num}/files"
        },
        {
          "note": "GitHub pull request commits",
          "url": "https://github.com/acme/widget/pull/42/commits",
          "title": null,
          "shape": "/acme/widget/pull/{num}/commits"
        },
        {
          "note": "GitHub pull request checks",
          "url": "https://github.com/acme/widget/pull/42/checks",
          "title": null,
          "shape": "/acme/widget/pull/{num}/checks"
        }
      ],
      "samples_shape": true
    },
    {
      "type": "github.issue",
      "key": "github.issue",
      "label": "GitHub issues",
      "label_variants": [],
      "description": "Issue pages are captured only for the organizations you name.",
      "record_label": "issues",
      "example_path": "/{scope}/example-repository/issues/123",
      "adapter": {
        "type": "github.issue",
        "match": [{ "path": "/{owner:name|lower}/{repo:name|lower}/issues/{number:int}" }],
        "scope": { "owner": { "$scope": true } },
        "id": "github.issue:{host}/{owner}/{repo}/{number}",
        "title": "{title} · Issue #{number:int} · {owner:name}/{repo:name} · GitHub",
        "refs": [{ "type": "jira.issue", "find": "jira_key" }],
        "within": { "type": "github.repo", "id": "github.repo:{host}/{owner}/{repo}" }
      },
      "history": [],
      "status": { "state": "certified", "method": "live", "checked_on": "2026-11-02", "checked_by": "John" },
      "docs": "docs/adapters/github.issue.md",
      "samples": [
        {
          "note": "GitHub issue",
          "url": "https://github.com/acme/widget/issues/42",
          "title": "Crash on start · Issue #42 · acme/widget · GitHub",
          "shape": "/acme/widget/issues/{num}"
        }
      ],
      "samples_shape": true
    },
    {
      "type": "github.repo",
      "key": "github.repo",
      "label": "GitHub repositories",
      "label_variants": [],
      "description": "Every page inside a repository counts toward it; pull requests and issues count toward both.",
      "record_label": "repositories",
      "example_path": "/{scope}/example-repository",
      "adapter": {
        "type": "github.repo",
        "match": [{ "path": "/{owner:name|lower}/{repo:name|lower}/{*}" }],
        "scope": { "owner": { "$scope": true } },
        "id": "github.repo:{host}/{owner}/{repo}"
      },
      "history": [],
      "status": { "state": "certified", "method": "live", "checked_on": "2026-11-02", "checked_by": "John" },
      "docs": "docs/adapters/github.repo.md",
      "samples": [],
      "samples_shape": false
    }
  ]
}
