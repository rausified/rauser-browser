{
  "family": "figma",
  "display_name": "Figma",
  "review_prompt": "Choose the kinds of Figma work to remember.",
  "origin": { "kind": "exact", "origin": "https://www.figma.com" },
  "scope": {
    "kind": "unscoped",
    "notice": "Records every Figma file and branch from every Figma account in this Chrome profile."
  },
  "sample_origin": "https://www.figma.com",
  "sample_scope": [],
  "overlaps": [{ "a": "figma.file", "b": "figma.branch", "expect": "disjoint" }],
  "types": [
    {
      "type": "figma.file",
      "key": "figma.file:{origin}",
      "label": "Figma files",
      "label_variants": [],
      "description": "Each file becomes one artifact, however it was opened or whichever Figma product it is, and the starter records it from every Figma account in this Chrome profile.",
      "record_label": "files",
      "example_path": null,
      "adapter": {
        "type": "figma.file",
        "match": [
          { "path": "/(file|design|board|slides|site|buzz|make|rev|spec|weave)/{key:token(22,128)}" },
          { "path": "/(file|design|board|slides|site|buzz|make|rev|spec|weave)/{key:token(22,128)}/{_}" },
          { "path": "/(proto|deck|presenter)/{key:token(22,128)}", "mode": "view" },
          { "path": "/(proto|deck|presenter)/{key:token(22,128)}/{_}", "mode": "view" }
        ],
        "unscoped": "acknowledged",
        "id": "figma.file:{host}/{key}",
        "generic_titles": ["Figma"],
        "title": ["{~} · {title} - Figma Slides", "{title} – {~}", "{title} - {~}"]
      },
      "history": [],
      "status": { "state": "development", "method": null, "checked_on": null, "checked_by": null },
      "docs": "docs/adapters/figma.file.md",
      "samples": [
        {
          "note": "Figma design file",
          "url": "https://www.figma.com/design/FigmaDevFileSample0000000000/Checkout-Flow",
          "title": "Checkout Flow – Figma",
          "shape": "/design/{id}/{slug}"
        },
        {
          "note": "Figma prototype",
          "url": "https://www.figma.com/proto/FigmaDevFileSample0000000000/Checkout-Flow?node-id=2654-15",
          "title": null,
          "shape": "/proto/{id}/{slug}?node-id={id}"
        }
      ],
      "samples_shape": true,
