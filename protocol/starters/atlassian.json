{
  "family": "atlassian",
  "display_name": "Atlassian Cloud (Jira or Confluence)",
  "review_prompt": "Choose the kinds of work to remember on this Atlassian site.",
  "origin": { "kind": "subdomain", "suffix": ".atlassian.net" },
  "scope": null,
  "sample_origin": "https://acme.atlassian.net",
  "sample_scope": [],
  "overlaps": [{ "a": "jira.issue", "b": "confluence.page", "expect": "disjoint" }],
  "types": [
    {
      "type": "jira.issue",
      "key": "jira:{origin}",
      "label": "Jira issues",
      "label_variants": [],
      "description": "Issue pages and board modals become one artifact per Jira key.",
      "record_label": null,
      "example_path": null,
      "adapter": {
        "type": "jira.issue",
        "match": [
          { "path": "/browse/{key:jira_key}" },
          { "path": "/jira/{*}", "query": { "selectedIssue": "{key:jira_key}" } }
        ],
        "id": "jira:{host}/{key}",
        "generic_titles": ["Jira", "Log in with Atlassian account", "Log in to continue - Log in with Atlassian account", "Choose an account to continue - Log in with Atlassian account"],
        "title": ["[{key:jira_key}] {title} - Jira", "[{key:jira_key}] {title} - {~} Jira"],
        "alias": { "from": "tab_title", "capture": "key" },
        "refs": [{ "type": "jira.issue", "find": "jira_key" }]
      },
      "history": [],
      "status": { "state": "certified", "method": "live", "checked_on": "2026-11-02", "checked_by": "John" },
      "docs": "docs/adapters/jira.issue.md",
      "samples": [
        {
          "note": "Jira canonical issue",
          "url": "https://acme.atlassian.net/browse/PROJ-42",
          "title": "[PROJ-42] Fix the bug - Jira",
          "shape": "/browse/{key}"
        },
        {
          "note": "Jira board modal",
          "url": "https://acme.atlassian.net/jira/software/projects/PROJ/boards/7?selectedIssue=PROJ-42",
          "title": null,
          "shape": "/jira/software/projects/{slug}/boards/{num}?{param}={key}"
        },
        {
          "note": "Jira issue on a renamed-product tenant",
          "url": "https://acme.atlassian.net/browse/PROJ-77",
          "title": "[PROJ-77] Fix login redirect loop - Acme Corp Jira",
          "shape": "/browse/{key}"
        }
      ],
      "samples_shape": true,
      "vectors": [
        {
          "id": "eval.jira.issue.title_renamed_product",
          "kind": "evaluate",
          "why": "brwr-njyw: a renamed-product tenant's title ends ' - <Company> Jira', so the first entry's exact ' - Jira' literal fails and the {~} entry skips the company name to extract the issue title",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-77" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-77",
            "mode": null,
            "title": "Fix login redirect loop",
            "title_entry": 1,
            "alias_id": null,
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-77",
          "title": "[PROJ-77] Fix login redirect loop - Acme Corp Jira"
        },
        {
          "id": "eval.jira.issue.title_plain_still_matches_first_entry",
          "kind": "evaluate",
          "why": "brwr-njyw: a plain '- Jira' title (no renamed product) still matches the first, non-skipping entry, unchanged by the new fallback entry",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-78" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-78",
            "mode": null,
            "title": "Simple one-line fix",
            "title_entry": 0,
            "alias_id": null,
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-78",
          "title": "[PROJ-78] Simple one-line fix - Jira"
        },
        {
          "id": "eval.jira.issue.title_internal_dash_renamed_product",
          "kind": "evaluate",
          "why": "brwr-njyw: a title with its own ' - ' still extracts whole on a renamed-product tenant, because {~} skips back to the ' - ' nearest the end, not the first one",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-79" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-79",
            "mode": null,
            "title": "Design - implementation review",
            "title_entry": 1,
            "alias_id": null,
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-79",
          "title": "[PROJ-79] Design - implementation review - Acme Corp Jira"
        },
        {
          "id": "eval.jira.issue.title_internal_dash_plain",
          "kind": "evaluate",
          "why": "brwr-njyw: the same internal-dash title with no renamed product matches the first entry whole and never reaches the {~} entry",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-80" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-80",
            "mode": null,
            "title": "Design - implementation review",
            "title_entry": 0,
            "alias_id": null,
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-80",
          "title": "[PROJ-80] Design - implementation review - Jira"
        },
        {
          "id": "eval.jira.issue.title_refs_survive_renamed_product",
          "kind": "evaluate",
          "why": "brwr-njyw: a cross-reference to another issue inside the title is preserved once the {~} entry extracts the title, instead of being lost in the whole-title fallback",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-81" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-81",
            "mode": null,
            "title": "Follow-up for OPS-5",
            "title_entry": 1,
            "alias_id": null,
            "refs": [{ "type": "jira.issue", "value": "OPS-5" }]
          },
          "url": "https://acme.atlassian.net/browse/PROJ-81",
          "title": "[PROJ-81] Follow-up for OPS-5 - Acme Corp Jira"
        },
        {
          "id": "eval.jira.issue.title_alias_survives_renamed_product",
          "kind": "evaluate",
          "why": "brwr-njyw: a moved-issue tab_title alias is still suggested once the {~} entry extracts the title on a renamed-product tenant",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-90" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-90",
            "mode": null,
            "title": "Moved issue",
            "title_entry": 1,
            "alias_id": "jira:acme.atlassian.net/OLD-9",
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-90",
          "title": "[OLD-9] Moved issue - Acme Corp Jira"
        },
        {
          "id": "eval.jira.issue.title_generic_interstitial_renamed_tenant",
          "kind": "evaluate",
          "why": "brwr-njyw: a generic sign-in interstitial on a renamed-product tenant still records no title, confirming generic_titles is unaffected by the new entry",
          "impls": ["rust", "ts"],
          "expect": {
            "match": true,
            "adapter": 0,
            "rule": 0,
            "type": "jira.issue",
            "captures": { "key": "PROJ-82" },
            "artifact_id": "jira:acme.atlassian.net/PROJ-82",
            "mode": null,
            "title": null,
            "title_entry": null,
            "alias_id": null,
            "refs": []
          },
          "url": "https://acme.atlassian.net/browse/PROJ-82",
          "title": "Log in with Atlassian account"
        }
      ]
    },
    {
      "type": "confluence.page",
      "key": "confluence.page:{origin}",
      "label": "Confluence pages",
      "label_variants": [],
      "description": "Each page becomes one artifact by its page ID, whether you view it, edit it, or open its version history.",
      "record_label": null,
      "example_path": null,
      "adapter": {
        "type": "confluence.page",
        "match": [
          { "path": "/wiki/spaces/{_}/pages/{id:int}/{*}" },
          { "path": "/wiki/spaces/{_}/pages/edit-v2/{id:int}", "mode": "edit" },
          { "path": "/wiki/spaces/{_}/history/{id:int}/{*}", "mode": "view" },
          { "path": "/wiki/pages/viewpage.action", "query": { "pageId": "{id:int}" } }
        ],
        "id": "confluence.page:{host}/{id}",
        "generic_titles": ["Confluence", "For you - Confluence", "Log in with Atlassian account", "Log in to continue - Log in with Atlassian account", "Choose an account to continue - Log in with Atlassian account"],
        "title": ["Version history - {title} - {~} - Confluence", "{title} - {~} - Confluence"],
        "refs": [{ "type": "jira.issue", "find": "jira_key" }]
      },
      "history": [],
      "status": { "state": "development", "method": null, "checked_on": null, "checked_by": null },
      "docs": "docs/adapters/confluence.page.md",
      "samples": [
        {
          "note": "Confluence page",
          "url": "https://acme.atlassian.net/wiki/spaces/ENG/pages/1000001/Release+Plan",
          "title": "Release plan - Engineering - Confluence",
          "shape": "/wiki/spaces/{slug}/pages/{num}/{slug}"
        },
        {
          "note": "Confluence page without a slug",
          "url": "https://acme.atlassian.net/wiki/spaces/ENG/pages/1000002",
          "title": null,
          "shape": "/wiki/spaces/{slug}/pages/{num}"
        },
        {
          "note": "Confluence page in a personal space",
          "url": "https://acme.atlassian.net/wiki/spaces/~0123456789abcdef0123456789abcdef012345/pages/1000003/Some+Page",
          "title": "Some Page - Alex Example - Confluence",
          "shape": "/wiki/spaces/{slug}/pages/{num}/{slug}"
        },
        {
          "note": "Confluence page version history",
          "url": "https://acme.atlassian.net/wiki/spaces/ENG/history/1000004/Release+Plan",
          "title": "Version history - Release plan - Engineering - Confluence",
          "shape": "/wiki/spaces/{slug}/history/{num}/{slug}"
        }
      ],
      "samples_shape": true,
      "vectors": []
    }
  ]
}
