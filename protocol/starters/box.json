{
  "family": "box",
  "display_name": "Box",
  "review_prompt": "Choose the kinds of Box items to remember on this Box site.",
  "origin": {
    "kind": "any",
    "of": [
      {
        "kind": "exact",
        "origin": "https://app.box.com"
      },
      {
        "kind": "subdomain",
        "suffix": ".app.box.com",
        "labels": 1,
        "exclude": [
          "www",
          "cloud",
          "fupload-*"
        ]
      },
      {
        "kind": "subdomain",
        "suffix": ".ent.box.com",
        "labels": 1,
        "exclude": [
          "www",
          "cloud",
          "fupload-*"
        ]
      }
    ]
  },
  "scope": null,
  "sample_origin": "https://acme.app.box.com",
  "sample_scope": [],
  "overlaps": [
    {
      "a": "box.file",
      "b": "box.folder",
      "expect": "disjoint"
    },
    {
      "a": "box.file",
      "b": "box.share",
      "expect": "disjoint"
    },
    {
      "a": "box.folder",
      "b": "box.share",
      "expect": "disjoint"
    }
  ],
  "types": [
    {
      "type": "box.file",
      "key": "box.file:{origin}",
      "label": "Box files",
      "label_variants": [],
      "description": "Each file, Box Note or Box Canvas becomes one artifact, keyed by its permanent file ID, however it was opened or edited. Records items from whichever Box account is signed in to this Chrome profile.",
      "record_label": "files",
      "example_path": null,
      "adapter": {
        "type": "box.file",
        "match": [
          {
            "path": "/file/{id:int}"
          },
          {
            "path": "/notes/{id:int}"
          },
          {
            "path": "/canvas/{id:int}"
          },
          {
            "path": "/s/{_}/file/{id:int}"
          },
          {
            "path": "/v/{_}/file/{id:int}"
          },
          {
            "path": "/integrations/officeonline/openOfficeOnline",
            "query": {
              "fileId": "{id:int}"
            },
            "mode": "edit"
          }
        ],
        "id": "box.file:{host}/{id}",
        "title": "{title} | Powered by Box"
      },
      "history": [],
      "status": {
        "state": "development",
        "method": null,
        "checked_on": null,
        "checked_by": null
      },
      "docs": "docs/adapters/box.file.md",
      "samples": [
        {
          "note": "Box file preview",
