{
  "family": "sharepoint",
  "display_name": "SharePoint/OneDrive",
  "review_prompt": null,
  "origin": { "kind": "subdomain", "suffix": ".sharepoint.com" },
  "scope": null,
  "sample_origin": "https://acme.sharepoint.com",
  "sample_scope": [],
  "overlaps": [],
  "types": [
    {
      "type": "sharepoint.doc",
      "key": "sharepoint:{origin}",
      "label": "SharePoint documents",
      "label_variants": [{ "host_suffix": "-my.sharepoint.com", "label": "OneDrive for work documents" }],
      "description": "Office document links resolve to the stable sourcedoc GUID, across common sharing routes.",
      "record_label": null,
      "example_path": null,
      "adapter": {
        "type": "sharepoint.doc",
        "path_case": "insensitive",
        "match": [
          { "path": "/sites/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } },
          { "path": "/(:w:|:x:|:p:)/(r|g)/(sites|personal)/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } },
          { "path": "/personal/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } }
        ],
        "id": "sharepoint:{host}/{doc}",
        "generic_titles": ["Working...", "Working…", "Login", "Redirecting", "Error", "Sign in is not complete"]
      },
      "history": [
        {
          "match": [
            { "path": "/sites/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } },
            { "path": "/:w:/r/sites/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } },
            { "path": "/personal/{_}/_layouts/15/Doc.aspx", "query": { "sourcedoc": "{doc:uuid}" } }
          ]
        }
      ],
      "status": { "state": "certified", "method": "live", "checked_on": "2026-11-02", "checked_by": "John" },
      "docs": "docs/adapters/sharepoint.doc.md",
      "samples": [
        {
          "note": "SharePoint site document",
          "url": "https://acme.sharepoint.com/sites/Eng/_layouts/15/Doc.aspx?sourcedoc=%7B0A1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D%7D&file=Plan.docx&action=default&mobileredirect=true",
          "title": null,
          "shape": "/sites/{slug}/_layouts/{num}/{slug}?action={slug}&file={slug}&mobileredirect={slug}&sourcedoc={uuid}"
        },
        {
          "note": "SharePoint personal document",
          "url": "https://acme-my.sharepoint.com/personal/jdoe_acme_com/_layouts/15/Doc.aspx?sourcedoc=0a1b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
          "title": null,
          "shape": "/personal/{slug}/_layouts/{num}/{slug}?sourcedoc={uuid}"
        },
        {
          "note": "SharePoint sharing form",
          "url": "https://acme.sharepoint.com/:w:/r/sites/Eng/_layouts/15/Doc.aspx?sourcedoc=%7B0A1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D%7D&file=Plan.docx&action=default&mobileredirect=true",
          "title": null,
          "shape": "/{slug}/r/sites/{slug}/_layouts/{num}/{slug}?action={slug}&file={slug}&mobileredirect={slug}&sourcedoc={uuid}"
        }
      ],
      "samples_shape": true,
      "vectors": []
    }
  ]
}
