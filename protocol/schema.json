{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rausified/rauser-browser/blob/main/protocol/schema.json",
  "title": "Brauser native messaging protocol",
  "description": "Version 6 messages exchanged by the Chrome extension and native host. Host-owned configuration, adapter policy, the config revision, and host-minted folder and harness tokens gate capture and writes.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloRequest"
        },
        {
          "$ref": "#/$defs/GetConfigRequest"
        },
        {
          "$ref": "#/$defs/UpdateConfigRequest"
        },
        {
          "$ref": "#/$defs/ChooseFolderRequest"
        },
        {
          "$ref": "#/$defs/RecordVisitRequest"
        },
        {
          "$ref": "#/$defs/RecordActivityRequest"
        },
        {
          "$ref": "#/$defs/RecordBatchRequest"
        },
        {
          "$ref": "#/$defs/RecordWhyRequest"
        },
        {
          "$ref": "#/$defs/LoadNoteRequest"
        },
        {
          "$ref": "#/$defs/SaveNoteRequest"
        },
        {
          "$ref": "#/$defs/UseArtifactNoteRequest"
        },
        {
          "$ref": "#/$defs/ViewOlderNoteRequest"
        },
        {
          "$ref": "#/$defs/GetArtifactRequest"
        },
        {
          "$ref": "#/$defs/ListArtifactsRequest"
        },
        {
          "$ref": "#/$defs/WorklogRequest"
        },
        {
          "$ref": "#/$defs/RefreshArtifactsRequest"
        },
        {
          "$ref": "#/$defs/CheckAgentRequest"
        },
        {
          "$ref": "#/$defs/DiscoverHarnessesRequest"
        },
        {
          "$ref": "#/$defs/ConfirmHarnessSetupRequest"
        }
      ]
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/$defs/HelloResult"
        },
        {
          "$ref": "#/$defs/ConfigResult"
        },
        {
          "$ref": "#/$defs/ConfigUpdated"
        },
        {
          "$ref": "#/$defs/FolderChosen"
        },
        {
          "$ref": "#/$defs/VisitRecorded"
        },
        {
          "$ref": "#/$defs/ActivityRecorded"
        },
        {
          "$ref": "#/$defs/BatchRecorded"
        },
        {
          "$ref": "#/$defs/WhyRecorded"
        },
        {
          "$ref": "#/$defs/NoteLoaded"
        },
        {
          "$ref": "#/$defs/NoteSaved"
        },
        {
          "$ref": "#/$defs/NoteConflict"
        },
        {
          "$ref": "#/$defs/ArtifactResult"
        },
        {
          "$ref": "#/$defs/ArtifactListResult"
        },
        {
          "$ref": "#/$defs/WorklogResult"
        },
        {
          "$ref": "#/$defs/ArtifactsRefreshed"
        },
        {
          "$ref": "#/$defs/AgentChecked"
        },
        {
          "$ref": "#/$defs/HarnessesDiscovered"
        },
        {
          "$ref": "#/$defs/HarnessSetupConfirmed"
        },
        {
          "$ref": "#/$defs/ErrorResponse"
        }
      ]
    },
    "HelloRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "GetConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "get_config"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "UpdateConfigRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "expected_revision",
        "config",
        "picker_token",
        "harness_token"
      ],
      "properties": {
        "type": {
          "const": "update_config"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "picker_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_token": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "host_version",
        "configured",
        "config_issue"
      ],
      "properties": {
        "type": {
          "const": "hello_result"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host_version": {
          "type": "string"
        },
        "configured": {
          "type": "boolean"
        },
        "config_issue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConfigResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "revision",
        "config",
        "config_issue",
        "agent_status",
        "adapter_issue",
        "adapter_warnings"
      ],
      "properties": {
        "type": {
          "const": "config_result"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        },
        "config_issue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "adapter_issue": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_warnings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/AdapterWarning"
          }
        }
      }
    },
    "ConfigUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "revision",
        "config"
      ],
      "properties": {
        "type": {
          "const": "config_updated"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "config": {
          "$ref": "#/$defs/ConfigSnapshot"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "description": "An empty request_id is allowed only when the host could not recover an ID from a malformed request.",
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "maxLength": 128
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_protocol_version",
        "invalid_config",
        "not_configured",
        "unauthorized",
        "conflict",
        "message_too_large",
        "internal",
        "cancelled"
      ]
    },
    "ConfigSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "capture_enabled",
        "sites",
        "strip_params",
        "agent",
        "adapters"
      ],
      "properties": {
        "storage": {
          "oneOf": [
            {
              "$ref": "#/$defs/StorageConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_enabled": {
          "type": "boolean"
        },
        "sites": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/SiteConfig"
          }
        },
        "strip_params": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "agent": {
          "oneOf": [
            {
              "$ref": "#/$defs/AgentConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapters": {
          "$ref": "#/$defs/AdapterDocument"
        }
      }
    },
    "AdapterDocument": {
      "type": "object",
      "additionalProperties": false,
      "description": "Format-versioned adapter-template document. Artifact objects are validated by the host's adapter-templates engine.",
      "required": [
        "format",
        "artifacts"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "minimum": 1
        },
        "artifacts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "AdapterWarning": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two rules that may recognize the same URL; the first configured rule wins.",
      "required": [
        "first_adapter",
        "first_rule",
        "second_adapter",
        "second_rule"
      ],
      "properties": {
        "first_adapter": {
          "type": "integer",
          "minimum": 0
        },
        "first_rule": {
          "type": "integer",
          "minimum": 0
        },
        "second_adapter": {
          "type": "integer",
          "minimum": 0
        },
        "second_rule": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StorageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "profile",
        "log_dir",
        "pages_dir",
        "later_dir",
        "artifacts_dir",
        "summaries_dir"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "log_dir": {
          "type": "string",
          "minLength": 1
        },
        "pages_dir": {
          "type": "string",
          "minLength": 1
        },
        "later_dir": {
          "type": "string",
          "minLength": 1
        },
        "artifacts_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summaries_dir": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "A confirmed harness entry. Only native harness setup can create or change it.",
      "required": [
        "harness_id",
        "adapter",
        "binary",
        "args",
        "env_allow",
        "timeout_secs"
      ],
      "properties": {
        "harness_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "adapter": {
          "$ref": "#/$defs/HarnessAdapter"
        },
        "binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "env_allow": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "HarnessAdapter": {
      "type": "string",
      "enum": [
        "claude_code",
        "codex"
      ]
    },
    "AgentStatus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Host-derived AI readiness. Reported in config_result only; never accepted from the extension.",
      "required": [
        "state",
        "harness_version",
        "message"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "harness_version": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AgentState": {
      "type": "string",
      "enum": [
        "not_set_up",
        "harness_problem",
        "ready"
      ]
    },
    "ChooseFolderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "choose_folder"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "RecordVisitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "event"
      ],
      "properties": {
        "type": {
          "const": "record_visit"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event": {
          "$ref": "#/$defs/VisitEvent"
        }
      }
    },
    "RecordActivityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "event"],
      "properties": {
        "type": { "const": "record_activity" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event": { "$ref": "#/$defs/ActivityEvent" }
      }
    },
    "RecordBatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "batch_id", "events", "overflow"],
      "properties": {
        "type": { "const": "record_batch" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "batch_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/CaptureBatchItem" }
        },
        "overflow": {
          "oneOf": [{ "$ref": "#/$defs/OverflowMarker" }, { "type": "null" }]
        }
      }
    },
    "RecordWhyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "event"],
      "properties": {
        "type": { "const": "record_why" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event": { "$ref": "#/$defs/WhyEvent" }
      }
    },
    "LoadNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "url"
      ],
      "properties": {
        "type": {
          "const": "load_note"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "SaveNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "url",
        "title",
        "body",
        "expected_revision",
        "expected_key"
      ],
      "properties": {
        "type": {
          "const": "save_note"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "maxLength": 98304
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_key": {
          "$ref": "#/$defs/RecordKey"
        }
      }
    },
    "UseArtifactNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "url", "source_url", "expected_revision"],
      "properties": {
        "type": { "const": "use_artifact_note" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "source_url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "expected_revision": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "ViewOlderNoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "url", "source_url"],
      "properties": {
        "type": { "const": "view_older_note" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "source_url": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "GetArtifactRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "url", "title"],
      "properties": {
        "type": { "const": "get_artifact" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "title": { "oneOf": [{ "type": "string", "maxLength": 2048 }, { "type": "null" }] }
      }
    },
    "ListArtifactsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "artifact_type", "title_query", "limit"],
      "properties": {
        "type": { "const": "list_artifacts" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "artifact_type": { "oneOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
        "title_query": { "oneOf": [{ "type": "string", "maxLength": 256 }, { "type": "null" }] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "WorklogRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "start_date", "end_date"],
      "properties": {
        "type": { "const": "worklog" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "start_date": { "type": "string", "minLength": 10, "maxLength": 10 },
        "end_date": { "type": "string", "minLength": 10, "maxLength": 10 }
      }
    },
    "RefreshArtifactsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id"],
      "properties": {
        "type": { "const": "refresh_artifacts" },
        "protocol_version": { "type": "integer", "const": 6 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "CheckAgentRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ask whether AI commands may run.",
      "required": [
        "type",
        "protocol_version",
        "request_id"
      ],
      "properties": {
        "type": {
          "const": "check_agent"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "FolderChosen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "path",
        "picker_token"
      ],
      "properties": {
        "type": {
          "const": "folder_chosen"
        },
        "protocol_version": {
          "type": "integer",
          "const": 6
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "picker_token": {
          "type": "string",
          "minLength": 1,
