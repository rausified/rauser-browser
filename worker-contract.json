{
  "version": 1,
  "merge": {
    "method": "label",
    "label": "queue",
    "comment": "@Mergifyio queue",
    "command": "node scripts/dev/queue-pr.mjs <pr> --head <sha>",
    "never": ["gh pr merge"]
  },
  "queue": {
    "transport": "bd-dolt",
    "bootstrap": "scripts/dev/queue bootstrap",
    "sync": "scripts/dev/queue sync",
    "export": "scripts/dev/queue export",
    "backlog": "scripts/dev/queue backlog --print",
    "sync_exit_codes": {
      "0": "synced",
      "1": "error",
      "2": "conflict",
      "3": "retry",
      "4": "stuck"
    }
  },
  "never_commit": [".beads/issues.jsonl", "BOSUN_FEATURE_BACKLOG.md"]
}
