# helpers


def lockfile_sha256(repo: Path) -> Optional[str]:
    try:
        return hashlib.sha256((repo / "package-lock.json").read_bytes()).hexdigest()
    except OSError:
        return None


def read_state(git_dir: Path) -> dict:
    try:
        value = json.loads((git_dir / STATE_FILE).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def write_state(git_dir: Path, state: dict) -> None:
    path = git_dir / STATE_FILE
    tmp = path.with_name(f".{STATE_FILE}.{uuid.uuid4().hex[:8]}")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def npm_ci_reason(repo: Path, git_dir: Path) -> Optional[str]:
    if not (repo / "node_modules").is_dir():
        return "node_modules is missing"
    recorded = read_state(git_dir).get("package_lock_sha256")
    if not recorded:
        return f"no npm ci recorded yet in {git_dir / STATE_FILE}"
    if lockfile_sha256(repo) != recorded:
        return "package-lock.json differs from the last npm ci"
    return None


def stage_copy(staged: Path, live: Path) -> Path:
    """Copy the staged binary next to the live one (same directory, so the
    later os.replace is an atomic rename); return the temporary file."""
    if not staged.is_file():
        raise DeployError(f"cargo build left no binary at {staged}")
    live.parent.mkdir(parents=True, exist_ok=True)
    tmp = live.with_name(f".{live.name}.deploy-{uuid.uuid4().hex[:8]}")
    try:
        shutil.copy2(staged, tmp)
    except OSError as exc:
        tmp.unlink(missing_ok=True)
        raise DeployError(f"cannot copy {staged} to {tmp}: {exc}") from exc
    return tmp


def dist_build(repo: Path) -> Optional[str]:
    """extension/dist's build: its manifest's version_name, trimmed, the
    value the extension's hello names once Chrome has loaded it."""
    try:
        name = json.loads((repo / "extension" / "dist" / "manifest.json")
                          .read_text(encoding="utf-8")).get("version_name")
    except (OSError, ValueError, AttributeError):
        return None
    return name.strip() or None if isinstance(name, str) else None


def read_loaded(support: Path) -> Optional[dict]:
    """The host's record of the last hello's build, or None when absent or
    not one."""
    try:
        value = json.loads((support / LOADED_FILE).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(value, dict):
        return None
    build, when = value.get("extension_build"), value.get("said_hello_unix")
    if not isinstance(build, str) or not build.strip():
        return None
    if not isinstance(when, int) or isinstance(when, bool):
        return None
    return {"build": build.strip(), "at": when}


def stamp(unix: float) -> str:
    return datetime.datetime.fromtimestamp(unix, datetime.timezone.utc).strftime(
        "%Y-%m-%d %H:%M:%SZ")


def loaded_state(record: Optional[dict], dist: Optional[str],
                 published: Optional[float]) -> tuple[str, str]:
    """(state, explanation): which extension build Chrome has loaded, from
    the host's record only. published is when this (or the last) deploy
    replaced the host binary, or None when unknown."""
    if dist is None:
        return "unavailable", "extension/dist names no build (no manifest version_name)"
    if record is None:
        return "unavailable", (f"no hello has named a build yet (extension/dist is {dist}); the "
                               "side panel or settings says hello when it opens")
    when = stamp(record["at"])
    if record["build"] == dist:
        return "loaded", f"Chrome has loaded {dist} (it said hello at {when})"
    if published is not None and record["at"] >= int(published):
        return "pending reload", (f"Chrome still runs {record['build']} (it said hello at {when}, "
                                  f"after the publish); extension/dist is {dist}")
    return "unavailable", (f"no hello since the publish says which build Chrome runs; the last, "
                           f"at {when}, was from {record['build']}, and extension/dist is {dist}")


RELOAD_PLAINLY = ("Chrome keeps running the old manifest and service worker until the unpacked "
                  "extension is reloaded; a new build on disk is not loaded by itself.")


def dist_digest(repo: Path) -> Optional[str]:
    dist = repo / "extension" / "dist"
    if not dist.is_dir():
        return None
    h = hashlib.sha256()
    for path in sorted(p for p in dist.rglob("*") if p.is_file()):
        h.update(str(path.relative_to(dist)).encode() + b"\0")
        try:
            h.update(path.read_bytes())
        except OSError:
            h.update(b"<unreadable>")
        h.update(b"\0")
    return h.hexdigest()


class Deploy:
    def __init__(self, runner: Runner, repo: Path, out, dry_run: bool,
                 pid_alive: Callable[[object], bool] = pid_alive,
                 clock: Callable[[], float] = time.time,
                 sleep: Callable[[float], None] = time.sleep):
        self.runner, self.repo, self.out, self.dry_run = runner, repo, out, dry_run
        self.pid_alive, self.clock, self.sleep = pid_alive, clock, sleep

    def say(self, text: str) -> None:
        print(text, file=self.out, flush=True)

    def step(self, label: str) -> None:
        self.say(f"==> {label}")

    def act(self, argv: list[str], what: str) -> None:
        """Run an acting command (or print it in a dry run); raise on failure."""
        if self.dry_run:
            self.say(f"    would run: {shlex.join(argv)}")
            return
        self.say(f"    $ {shlex.join(argv)}")
        res = self.runner(argv, cwd=self.repo, stream=True)
        if res.returncode != 0:
            raise DeployError(f"{what} failed (exit {res.returncode})"
                              + (f": {res.err}" if res.err else ""))


# --------------------------------------------------------------------------
# CLI


def exec_script(argv: list[str]) -> None:
    """Replace this process with `argv` (the pulled deploy-live)."""
    os.execv(argv[0], argv)


def main(argv: Optional[list[str]] = None, runner: Optional[Runner] = None, out=sys.stdout,
         home: Optional[Path] = None, platform: Optional[str] = None,
         running_script: Optional[Path] = None,
         reexec: Optional[Callable[[list[str]], None]] = None,
         pid_alive: Callable[[object], bool] = pid_alive,
         clock: Callable[[], float] = time.time,
         sleep: Callable[[float], None] = time.sleep) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    # The bytes of the deploy-live now running, read before the pull can
    # replace the file.
    try:
        running = (running_script or Path(__file__).resolve()).read_bytes()
    except OSError:
        running = None
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--repo", type=Path,
                        help="main checkout to deploy (default: the main worktree of this "
                             "script's repository)")
    parser.add_argument("--extension-id", help="Chrome extension ID (default: from the native "
                                               "host manifest's allowed_origins)")
    parser.add_argument("--allow-active-runs", action="store_true",
                        help="deploy even with runs queued or running (the restart ends them)")
    parser.add_argument("--support-dir", type=Path,
                        help="Brauser support dir (default: ~/Library/Application Support/Brauser)")
    parser.add_argument("--native-host-manifest", type=Path,
                        help="native host manifest to read the extension ID from")
    parser.add_argument("--expected-sha", metavar="SHA",
                        help="deploy exactly this commit of origin/main (7 to 40 hex digits), "
                             "fast-forwarding to it instead of pulling; refuse anything else")
    parser.add_argument("--drain", action="store_true",
                        help="after the builds, pause new runs and wait for queued and running "
                             "ones to finish before publishing, instead of refusing")
    parser.add_argument("--drain-timeout", metavar="SECONDS", default=str(DRAIN_TIMEOUT),
                        help=f"how long --drain waits (1 to {DRAIN_TIMEOUT_MAX}, default "
                             f"{DRAIN_TIMEOUT})")
    parser.add_argument("--dry-run", action="store_true", help="print the steps; change nothing")
    parser.add_argument("--loaded", action="store_true",
                        help="only report which extension build Chrome has loaded (read-only; "
                             "exit 0 loaded, 3 pending reload, 4 unavailable)")
    # Set only by deploy-live itself when a pull changed it (step d).
    parser.add_argument("--resumed-from", help=argparse.SUPPRESS)
    args = parser.parse_args(argv)

    platform = sys.platform if platform is None else platform
    if platform != "darwin":
        print(f"deploy-live: error: deploy-live only runs on macOS (the live install is a "
              f"LaunchAgent and the macOS Chrome native-messaging manifest); this is {platform}",
              file=out)
        return 2
    runner = runner or system_runner
    home = home or Path.home()
    support = args.support_dir or default_support_dir(home)
    manifest = args.native_host_manifest or default_manifest(home)
    drain_marker: Optional[Path] = None
    published_at: Optional[float] = None
    d: Optional[Deploy] = None
    local_ancestry: Optional[bool] = None
    old_handlers = trap_signals()
    try:
        repo = (args.repo or default_repo(runner, Path(__file__).resolve().parent)).resolve()
        d = Deploy(runner, repo, out, args.dry_run, pid_alive, clock, sleep)
        d.say(f"deploy-live: {repo}" + (" (dry run: nothing changes)" if args.dry_run else "")
              + (" (resumed in the pulled deploy-live)" if args.resumed_from else ""))
        if args.resumed_from is not None and not re.fullmatch(r"[0-9a-f]{40}", args.resumed_from):
            raise DeployError(f"--resumed-from needs a full commit ID, not {args.resumed_from!r}")
        expected = args.expected_sha
        if expected is not None and not SHA.match(expected):
            raise DeployError(f"--expected-sha needs 7 to 40 lowercase hex digits, not {expected!r}")
        try:
            drain_timeout = int(args.drain_timeout)
        except ValueError:
            drain_timeout = 0
        if not 1 <= drain_timeout <= DRAIN_TIMEOUT_MAX:
            raise DeployError(f"--drain-timeout needs whole seconds from 1 to {DRAIN_TIMEOUT_MAX}, "
                              f"not {args.drain_timeout!r}")

        if args.loaded:
            common = git_text(runner, repo, "rev-parse", "--path-format=absolute",
                              "--git-common-dir")
            published = read_state(Path(common)).get("published_unix")
            state, why = loaded_state(read_loaded(support), dist_build(repo),
                                      published if isinstance(published, (int, float)) else None)
            d.say(f"  loaded:    {state}: {why}")
            if state == "pending reload":
                d.say(f"  {RELOAD_PLAINLY}")
                d.say("  Reload Brauser: click Reload Brauser in the side panel, or reload it at "
                      "chrome://extensions; then open the side panel and rerun --loaded.")
            return LOADED_EXIT[state]

        d.step("checkout: main worktree, branch main, no tracked changes")
        git_dir = check_checkout(runner, repo)
        d.say("    ok")

        d.step(f"runs in {support / 'runs'}")
        active = check_runs(d, support, args.allow_active_runs, drain=args.drain)
        stale = report_stale(d, support)

        if args.extension_id is not None:
            if not EXTENSION_ID.match(args.extension_id):
                raise DeployError(f"{args.extension_id!r} is not a Chrome extension ID "
                                  "(32 letters a-p)")
            ext_id = args.extension_id
        else:
            ext_id = extension_id_from_manifest(manifest)
        binary = repo / "target" / "debug" / "brauser"
        staging = repo / STAGING
        staged = staging / "debug" / "brauser"
        if args.drain and not honours_drain(binary):
            raise DeployError(f"--drain needs a service that honours the pause, and {binary} "
                              "predates it, so a run could still start and be ended by the "
                              "restart. Deploy once without --drain (wait for a quiet moment); "
                              "later deploys can drain.")

        d.step("stale index.lock files (worktree-hygiene --locks-only)")
        hygiene = [sys.executable, str(HYGIENE), "--repo", str(repo), "--locks-only"]
        if not args.dry_run:
            hygiene.append("--apply")
        res = runner(hygiene, cwd=repo)
        for line in res.text.splitlines():
            d.say("    " + line)
        if res.returncode != 0:
            raise DeployError(f"worktree-hygiene --locks-only failed (exit {res.returncode})"
                              + (f": {res.err}" if res.err else ""))
        lock_lines = [ln.strip() for ln in res.text.splitlines()
                      if ln.strip().startswith(("cleared", "keep", "clear ", "failed"))]

        old = args.resumed_from or git_text(runner, repo, "rev-parse", "HEAD")
        dist_before = dist_digest(repo)

        # Read-only, so a dry run can say what the pull would bring.
        d.step("origin main (git ls-remote)")
        remote, remote_err = remote_main(runner, repo)
        head_now = git_text(runner, repo, "rev-parse", "HEAD")
        d.say(f"    local HEAD {head_now[:COMMIT_LENGTH]}; "
              + (f"origin main {remote[:COMMIT_LENGTH]}" if remote
                 else f"origin main: unavailable ({remote_err})"))

        if expected is not None:
            d.step(f"fast-forward to --expected-sha {expected}")
        else:
            d.step("git pull --ff-only")
        if args.resumed_from is not None:
            # This copy is the one the first pull brought; pulling again could
            # bring a newer deploy-live that this run would not execute.
            new = git_text(runner, repo, "rev-parse", "HEAD")
            if expected is not None and not new.startswith(expected):
                raise DeployError(f"HEAD is {new[:COMMIT_LENGTH]}, not --expected-sha {expected}")
            d.say(f"    pulled by the first run: {old[:COMMIT_LENGTH]}..{new[:COMMIT_LENGTH]}")
        elif args.dry_run:
            new = old
            if expected is not None:
                e = expected[:COMMIT_LENGTH]
                local_ancestry = on_local_origin_main(runner, repo, expected)
                d.say(f"    on the local origin/main ref: {ancestry_note(local_ancestry)}")
                if old.startswith(expected) and remote == old:
                    d.say(f"    would deploy {e}: it is checked out and origin main's tip")
                elif old.startswith(expected):
                    d.say(f"    would fetch origin main, then would deploy {e} (checked out) "
                          "only if it is on origin/main; otherwise it refuses")
                elif remote and remote.startswith(expected):
                    d.say(f"    would fetch origin main and fast-forward {old[:COMMIT_LENGTH]}..{e}; "
                          f"would deploy {e} (origin main's tip)")
                else:
                    d.say(f"    would fetch origin main, then would deploy {e} only if it is on "
                          f"origin/main and {old[:COMMIT_LENGTH]} is its ancestor (origin main is "
                          + (f"at {remote[:COMMIT_LENGTH]}" if remote else "unavailable")
                          + "); otherwise it refuses")
            else:
                d.act(["git", "-C", str(repo), "pull", "--ff-only"], "git pull")
                if remote is None:
                    d.say("    what the pull brings is unknown: origin main is unavailable")
                elif remote == old:
                    d.say(f"    up to date with origin main at {old[:COMMIT_LENGTH]}")
                else:
                    d.say(f"    would pull {old[:COMMIT_LENGTH]}..{remote[:COMMIT_LENGTH]} "
                          "(git pull --ff-only refuses if the checkout diverged)")
        else:
            if expected is not None:
                new = fast_forward_to(d, runner, repo, old, expected)
                if remote and remote != new:
                    d.say(f"    origin main is at {remote[:COMMIT_LENGTH]}; deploying "
                          f"{new[:COMMIT_LENGTH]} as --expected-sha asks")
            else:
                res = git(runner, repo, "pull", "--ff-only")
                if res.returncode != 0:
                    raise DeployError("git pull --ff-only failed: " + (res.err or res.text.strip())
                                      + "\n(an index.lock kept above blocks the pull; see "
                                        "scripts/dev/index-lock-watch to find who leaves it)")
                new = git_text(runner, repo, "rev-parse", "HEAD")
                d.say(f"    {old[:COMMIT_LENGTH]}..{new[:COMMIT_LENGTH]}" if new != old
                      else f"    already up to date at {old[:COMMIT_LENGTH]}")
            pulled = repo / SELF
            try:
                changed = new != old and running is not None and pulled.read_bytes() != running
            except OSError:
                changed = False
            if changed and args.resumed_from is None:
                d.say(f"    deploy-live changed in this pull; continuing in {pulled}")
                out.flush()
                (reexec or exec_script)([sys.executable, str(pulled), *argv,
                                         "--resumed-from", old])
                return 0

        d.step("Node TypeScript import preflight")
        found_node = check_node(runner, repo)
        d.say(f"    {found_node}: extension/brand.ts imports successfully")

        d.step(f"cargo build --locked -p brauser (into {STAGING}; the live binary waits)")
        d.act(["cargo", "build", "--locked", "-p", "brauser", "--target-dir", str(staging)],
              "cargo build --locked -p brauser")

        d.step("npm ci")
        npm_reason = npm_ci_reason(repo, git_dir)
        if args.dry_run and not npm_reason:
            d.say("    would run npm ci --ignore-scripts if the pull changes package-lock.json")
            npm_note = "npm ci: decided after the pull"
        elif npm_reason:
            d.say(f"    {npm_reason}")
            if not args.dry_run:
                # No receipt while npm ci runs: an interrupted install that
                # left a partial node_modules must not look finished.
                state = read_state(git_dir)
                if state.pop("package_lock_sha256", None) is not None:
                    write_state(git_dir, state)
            d.act(["npm", "ci", "--ignore-scripts"], "npm ci")
            if not args.dry_run:
                write_state(git_dir, {**read_state(git_dir),
                                      "package_lock_sha256": lockfile_sha256(repo)})
            npm_note = f"npm ci: {'would run' if args.dry_run else 'ran'} ({npm_reason})"
        else:
            npm_note = "npm ci: skipped (package-lock.json matches the last npm ci)"
            d.say("    " + npm_note)

        d.step("npm run build:extension")
        d.act(["npm", "run", "build:extension"], "npm run build:extension")
        if not args.dry_run and dist_digest(repo) != dist_before:
            # Chrome now needs a reload even if a later step refuses this
            # deploy; a retry at the same commit rebuilds an identical dist.
            write_state(git_dir, {**read_state(git_dir), "pending_extension_reload": True})

        # The builds above can take minutes; a run queued or started meanwhile
        # would be ended by the service restart below, so check again before
        # the live binary changes.
        late = LATE_REFUSAL.format(staging=staging)
        if args.drain:
            d.step(f"drain: pause new runs, then wait up to {drain_timeout}s for queued and "
                   "running runs")
            if args.dry_run:
                d.say(f"    would pause new runs by writing {support / DRAIN_FILE}, wait for "
                      "queued and running runs, and lift the pause when the deploy ends")
            elif not support.is_dir():
                d.say(f"    no {support}: no service has run, so there is nothing to drain")
            else:
                now = d.clock()
                drain_marker = write_drain(support, now + drain_timeout + DRAIN_GRACE, now)
                d.say(f"    paused new runs ({drain_marker})")
                # A start_run that passed the pause check just before the
                # marker landed may not have written its status.json yet.
                d.sleep(DRAIN_POLL)
                drain_runs(d, support, drain_timeout, args.allow_active_runs, late)
        d.step(f"runs in {support / 'runs'} (again, before the binary is published)")
        # A dry run waits for nothing, so the runs a drain would wait for
        # are reported, not refused.
        for run in check_runs(d, support, args.allow_active_runs, late,
                              drain=args.drain and args.dry_run):
            if run not in active:
                active.append(run)

        d.step(f"publish {staged} to {binary}")
        if args.dry_run:
            d.say(f"    would copy {staged} to a temporary file in {binary.parent}, check runs "
                  f"once more, then os.replace it onto {binary}")
        else:
            tmp = stage_copy(staged, binary)
            try:
                for run in check_runs(d, support, args.allow_active_runs, late):
                    if run not in active:
                        active.append(run)
                os.replace(tmp, binary)
                published_at = d.clock()
            finally:
                tmp.unlink(missing_ok=True)
            write_state(git_dir, {**read_state(git_dir), "published_unix": int(published_at)})
            d.say(f"    replaced {binary}")

        d.step("register the native host and service")
        d.act(["node", "scripts/register-dev-host.mjs", ext_id, str(binary)],
              "node scripts/register-dev-host.mjs")

        d.step("hello to the new host")
        origin = f"chrome-extension://{ext_id}/"
        if args.dry_run:
            d.say(f"    would send a framed hello to {binary} {origin} and check protocol_version "
                  f"and host_version +<new HEAD {COMMIT_LENGTH} chars>")
            host_version = "(dry run)"
        else:
            version = protocol_version(repo)
            res = runner([str(binary), origin], cwd=repo,
                         input=hello_frame(version, f"deploy-live-{uuid.uuid4().hex[:8]}"),
                         timeout=HELLO_TIMEOUT)
            if res.returncode != 0 and not res.stdout:
                raise DeployError(f"hello to {binary} failed (exit {res.returncode})"
                                  + (f": {res.err}" if res.err else ""))
            host_version = verify_hello(parse_frame(res.stdout), version, new)
            d.say(f"    host_version {host_version}, protocol_version {version}")

        pending = read_state(git_dir).get("pending_extension_reload") is True
        extension_changed = (not args.dry_run) and (dist_digest(repo) != dist_before or pending)
        d.say("")
        d.say("summary" + (" (dry run)" if args.dry_run else ""))
        if args.dry_run:
            target = (f"would deploy {expected[:COMMIT_LENGTH]} if it is on origin/main "
                      f"({ancestry_note(local_ancestry)})"
                      if expected is not None else
                      "origin main unavailable, so what the pull brings is unknown"
                      if remote is None else
                      f"up to date with origin main at {old[:COMMIT_LENGTH]}" if remote == old
                      else f"would pull {old[:COMMIT_LENGTH]}..{remote[:COMMIT_LENGTH]}")
            d.say(f"  commits:   local HEAD {old[:COMMIT_LENGTH]}; " + target)
        else:
            d.say(f"  commits:   {old[:COMMIT_LENGTH]}..{new[:COMMIT_LENGTH]}" if new != old
                  else f"  commits:   already up to date at {old[:COMMIT_LENGTH]}")
            if remote and remote != new:
                d.say(f"  origin:    main is at {remote[:COMMIT_LENGTH]}")
        d.say("  locks:     " + ("; ".join(lock_lines) if lock_lines else "none"))
        d.say(f"  {npm_note}")
        d.say(f"  host:      {host_version} ({binary})")
        if args.dry_run:
            d.say(f"  extension: {ext_id}, rebuilt by the deploy; whether it changed is known "
                  "after the build" + (" (a reload is already pending)" if pending else ""))
        else:
            d.say(f"  extension: {ext_id}" + (", changed" if extension_changed else ", unchanged"))
        if stale:
            d.say("  stale runs: " + ", ".join(stale))
        # Only the host's record of a hello says which build Chrome has
        # loaded (brwr-x622); without one since the publish, it says so.
        if args.dry_run:
            published = read_state(git_dir).get("published_unix")
            published = published if isinstance(published, (int, float)) else None
        else:
            published = published_at
        loaded, why = loaded_state(read_loaded(support), dist_build(repo), published)
        d.say(f"  loaded:    {'now ' if args.dry_run else ''}{loaded}: {why}")
        if extension_changed or loaded == "pending reload":
            d.say(f"  {RELOAD_PLAINLY}")
            d.say("  Reload Brauser: click Reload Brauser in the side panel (its \"Brauser was")
            d.say("  updated\" banner), then check the panel's extension and host IDs match;")
            d.say("  reload at chrome://extensions only if the panel cannot. Then open the side")
            d.say("  panel and run scripts/dev/deploy-live --loaded to confirm.")
        if active:
            d.say("  runs that were active: " + ", ".join(active))
        if not args.dry_run:
            state = read_state(git_dir)
            if state.pop("pending_extension_reload", None) is not None:
                write_state(git_dir, state)
        return 0
    except DeployError as exc:
        print(f"deploy-live: error: {exc}", file=out)
        return 1
    except Signalled as exc:
        name = signal.Signals(exc.signum).name
        print(f"deploy-live: stopped by {name}", file=out)
        return 128 + exc.signum
    finally:
        try:
            if drain_marker is not None:
                try:
                    drain_marker.unlink(missing_ok=True)
                    print(f"    lifted the pause on new runs ({drain_marker})", file=out)
                except OSError as exc:
                    print(f"deploy-live: warning: cannot remove {drain_marker}: {exc}; new runs "
                          f"stay paused until it expires (at most {DRAIN_MAX}s)", file=out)
        finally:
            restore_signals(old_handlers)


if __name__ == "__main__":
    sys.exit(main())
