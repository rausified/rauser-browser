# checks


def git(runner: Runner, repo: Path, *args: str) -> Result:
    return runner(["git", "-C", str(repo), *args], cwd=repo)


def git_text(runner: Runner, repo: Path, *args: str) -> str:
    res = git(runner, repo, *args)
    if res.returncode != 0:
        raise DeployError(f"git {' '.join(args)} failed in {repo}: {res.err}")
    return res.text.strip()


def same_path(a: str, b: Path) -> bool:
    return os.path.realpath(a) == os.path.realpath(str(b))


def check_checkout(runner: Runner, repo: Path) -> Path:
    """Refuse anything but the main worktree on a clean main; return its git dir."""
    lines = git_text(runner, repo, "rev-parse", "--path-format=absolute", "--show-toplevel",
                     "--git-dir", "--git-common-dir").splitlines()
    if len(lines) != 3:
        raise DeployError(f"unexpected git rev-parse output in {repo}: {lines}")
    toplevel, git_dir, common_dir = lines
    if not same_path(toplevel, repo):
        raise DeployError(f"{repo} is not the top of its checkout ({toplevel} is)")
    if os.path.realpath(git_dir) != os.path.realpath(common_dir):
        raise DeployError(f"{repo} is a linked worktree; deploy from the main worktree "
                          f"(the live install), not {git_dir}")
    branch = git(runner, repo, "symbolic-ref", "--short", "-q", "HEAD")
    name = branch.text.strip() if branch.returncode == 0 else ""
    if not name:
        raise DeployError(f"{repo} is not on a branch (detached HEAD); check out main")
    if name != "main":
        raise DeployError(f"{repo} is on branch {name}, not main")
    status = git_text(runner, repo, "status", "--porcelain", "--untracked-files=no")
    if status:
        n = len(status.splitlines())
        raise DeployError(f"{repo} has {n} tracked changes; commit, stash or revert them first:\n"
                          + status)
    return Path(common_dir)


def pid_alive(pid: object) -> bool:
    """Whether a process with this ID exists (signal 0 checks, sends nothing)."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # it exists; it is another user's
    except OSError:
        return False
    return True


def heartbeat_age(stamp: object, now: float) -> Optional[float]:
    """Seconds since an RFC 3339 heartbeat_at, or None when absent or unparsable."""
    if not isinstance(stamp, str):
        return None
    # Rust writes up to nanoseconds; fromisoformat takes at most microseconds.
    text = re.sub(r"(\.\d{6})\d+", r"\1", stamp.replace("Z", "+00:00"))
    try:
        when = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    if when.tzinfo is None:
        return None
    return max(0.0, now - when.timestamp())


def ago(seconds: float) -> str:
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h"


def scan_runs(support: Path, alive: Callable[[object], bool] = pid_alive,
              now: Optional[float] = None) -> tuple[list[str], list[str]]:
    """(active, stale) runs. Active: queued or running under a live (or
    unnamed) service, plus runs whose status.json cannot be read. Stale:
    queued or running, but the record's service_pid names no live process,
    so the service that owned it is gone (crashed, or a previous build that
    exited) and a restart cannot end it further; the next service start
    recovers it (supervisor.rs: a running run fails with service_restarted,
    a queued summary resumes, a queued task fails)."""
    runs = support / "runs"
    if not runs.is_dir():
        return [], []
    now = time.time() if now is None else now
    active, stale = [], []
    for d in sorted(runs.iterdir()):
        status = d / "status.json"
        if not d.is_dir() or not status.exists():
            continue
        try:
            data = json.loads(status.read_text(encoding="utf-8"))
            state = data.get("state")
        except (OSError, ValueError, AttributeError) as exc:
            active.append(f"{d.name} (unreadable status.json: {exc})")
            continue
        if state not in ACTIVE_STATES:
            continue
        pid = data.get("service_pid")
        age = heartbeat_age(data.get("heartbeat_at"), now)
        beat = f"; heartbeat {ago(age)} ago" if age is not None else ""
        named = isinstance(pid, int) and not isinstance(pid, bool) and pid > 0
        if named and not alive(pid):
            stale.append(f"{d.name} ({state}; service pid {pid} is not running{beat})")
        else:
            active.append(f"{d.name} ({state}" + (f"; service pid {pid}" if named else "")
                          + f"{beat})")
    return active, stale


def active_runs(support: Path, alive: Callable[[object], bool] = pid_alive,
                now: Optional[float] = None) -> list[str]:
    """Runs a service restart would end (scan_runs' first list)."""
    return scan_runs(support, alive, now)[0]


STALE_NOTE = ("stale: their service is gone, so the restart cannot end them; the next service "
              "start recovers them (a running run fails with service_restarted, a queued summary "
              "resumes, a queued task fails)")


LATE_REFUSAL = ("The live binary is untouched (the new build is staged in {staging}); "
                "extension/dist is already rebuilt, so do not reload Brauser at "
                "chrome://extensions yet. Wait for the runs to finish, then rerun "
                "scripts/dev/deploy-live (the staged build makes it quick).")


def check_runs(d: "Deploy", support: Path, allow: bool, late: str = "",
               drain: bool = False) -> list[str]:
    """Refuse (unless allowed) while runs are queued or running; report them.
    late is added to the refusal once the builds have run. With drain, the
    runs are reported and waited for after the builds instead."""
    active = active_runs(support, d.pid_alive, d.clock())
    if active and not (allow or drain):
        raise DeployError("Brauser runs are queued or running; the service restart would end "
                          "them. Wait for them, pass --drain to wait for them after the builds, "
                          "or pass --allow-active-runs: "
                          + ", ".join(active) + (f"\n{late}" if late else ""))
    if active and not allow:
        d.say("    waiting for them after the builds (--drain): " + ", ".join(active))
    else:
        d.say("    " + ("deploying anyway (--allow-active-runs): " + ", ".join(active)
                        if active else "none queued or running"))
    return active


def report_stale(d: "Deploy", support: Path) -> list[str]:
    stale = scan_runs(support, d.pid_alive, d.clock())[1]
    if stale:
        d.say(f"    {STALE_NOTE}: " + ", ".join(stale))
    return stale


def write_drain(support: Path, until: float, now: float) -> Path:
    """Write the pause marker the service reads (DRAIN_FILE), atomically, 0600."""
    path = support / DRAIN_FILE
    tmp = path.with_name(f".{DRAIN_FILE}.{uuid.uuid4().hex[:8]}")
    body = json.dumps({"version": 1, "until_unix": int(until), "written_unix": int(now),
                       "by": "deploy-live", "pid": os.getpid()}) + "\n"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(body)
        os.replace(tmp, path)
    except OSError as exc:
        tmp.unlink(missing_ok=True)
        raise DeployError(f"cannot write the drain marker {path}: {exc}") from exc
    return path


def drain_runs(d: "Deploy", support: Path, timeout: int, allow: bool, late: str) -> None:
    """Wait up to timeout seconds for the active runs to finish."""
    deadline = d.clock() + timeout
    last: Optional[list[str]] = None
    while True:
        active = active_runs(support, d.pid_alive, d.clock())
        if not active:
            d.say("    drained: none queued or running")
            return
        if active != last:
            d.say("    waiting for: " + ", ".join(active))
            last = active
        if d.clock() >= deadline:
            if allow:
                d.say(f"    still active after {timeout}s; deploying anyway "
                      "(--allow-active-runs): " + ", ".join(active))
                return
            raise DeployError(f"Brauser runs did not finish within {timeout}s (--drain-timeout): "
                              + ", ".join(active) + f"\n{late}")
        d.sleep(DRAIN_POLL)


def remote_main(runner: Runner, repo: Path) -> tuple[Optional[str], str]:
    """origin main's commit by `git ls-remote` (reads, changes nothing), or
    (None, why not). Bounded and never prompting: an unreachable remote or
    one asking for credentials is "unavailable", not a hung deploy."""
    res = runner(["git", "-C", str(repo), "ls-remote", "origin", "refs/heads/main"], cwd=repo,
                 timeout=LS_REMOTE_TIMEOUT, env={"GIT_TERMINAL_PROMPT": "0"})
    if res.returncode != 0:
        return None, res.err or f"git ls-remote exit {res.returncode}"
    for line in res.text.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == "refs/heads/main" and re.fullmatch(r"[0-9a-f]{40}",
                                                                              parts[0]):
            return parts[0], ""
    return None, "git ls-remote printed no refs/heads/main"


def on_local_origin_main(runner: Runner, repo: Path, expected: str) -> Optional[bool]:
    """Whether the expected commit is on the local origin/main ref (as of the
    last fetch; read-only): True, False, or None when it is not a commit here."""
    if git(runner, repo, "rev-parse", "--verify", "-q", f"{expected}^{{commit}}").returncode != 0:
        return None
    return git(runner, repo, "merge-base", "--is-ancestor", expected,
               "origin/main").returncode == 0


def ancestry_note(found: Optional[bool]) -> str:
    return {True: "yes as of the last fetch",
            False: "not as of the last fetch; the fetch decides",
            None: "unknown: not a commit here until a fetch brings it"}[found]


def fast_forward_to(d: "Deploy", runner: Runner, repo: Path, old: str, expected: str) -> str:
    """Fetch origin main and fast-forward exactly to the expected commit;
    refuse one that is not on origin main or that HEAD is already past."""
    res = git(runner, repo, "fetch", "origin", "main")
    if res.returncode != 0:
        raise DeployError("git fetch origin main failed: " + (res.err or res.text.strip()))
    res = git(runner, repo, "rev-parse", "--verify", f"{expected}^{{commit}}")
    if res.returncode != 0:
        raise DeployError(f"--expected-sha {expected} is not a commit here even after fetching "
                          "origin main; nothing was deployed")
    full = res.text.strip()
    if not full.startswith(expected):
        # git prefers a ref with this name (a branch or tag "abcdef0") to a short SHA.
        raise DeployError(f"--expected-sha {expected} resolves to {full[:COMMIT_LENGTH]}, a ref "
                          "with that name, not the commit; pass the full 40-character SHA")
    if git(runner, repo, "merge-base", "--is-ancestor", full, "origin/main").returncode != 0:
        raise DeployError(f"--expected-sha {full[:COMMIT_LENGTH]} is not on origin/main; "
                          "nothing was deployed")
    if full == old:
        d.say(f"    already at expected {full[:COMMIT_LENGTH]}")
        return full
    if git(runner, repo, "merge-base", "--is-ancestor", "HEAD", full).returncode != 0:
        raise DeployError(f"the checkout is at {old[:COMMIT_LENGTH]}, newer than (or diverged "
                          f"from) --expected-sha {full[:COMMIT_LENGTH]}; refusing to deploy "
                          "anything else")
    res = git(runner, repo, "merge", "--ff-only", full)
    if res.returncode != 0:
        raise DeployError(f"git merge --ff-only {full[:COMMIT_LENGTH]} failed: "
                          + (res.err or res.text.strip()))
    new = git_text(runner, repo, "rev-parse", "HEAD")
    if new != full:
        raise DeployError(f"HEAD is {new[:COMMIT_LENGTH]} after the fast-forward, not "
                          f"{full[:COMMIT_LENGTH]}")
    d.say(f"    {old[:COMMIT_LENGTH]}..{new[:COMMIT_LENGTH]} (expected {full[:COMMIT_LENGTH]})")
    return new


def extension_id_from_manifest(path: Path) -> str:
    if not path.exists():
        raise DeployError(f"no native host manifest at {path}; pass --extension-id "
                          "(the ID shown at chrome://extensions)")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        origins = data["allowed_origins"]
        if not isinstance(origins, list):
            raise ValueError("allowed_origins is not a list")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise DeployError(f"cannot read the extension ID from {path}: {exc}; "
                          "pass --extension-id") from exc
    if len(origins) != 1:
        raise DeployError(f"{path} has {len(origins)} allowed_origins entries, not one; "
                          "pass --extension-id")
    match = ORIGIN.match(str(origins[0]))
    if not match:
        raise DeployError(f"{path}: {origins[0]!r} is not a Chrome extension origin; "
                          "pass --extension-id")
    return match.group(1)


def protocol_version(repo: Path) -> int:
    path = repo / "protocol" / "src" / "generated.rs"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise DeployError(f"cannot read {path}: {exc}") from exc
    match = re.search(r"pub const PROTOCOL_VERSION: u32 = (\d+);", text)
    if not match:
        raise DeployError(f"no PROTOCOL_VERSION in {path}")
    return int(match.group(1))


