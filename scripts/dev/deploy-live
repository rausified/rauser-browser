HOST_NAME = "com.rauser.brauser"
EXTENSION_ID = re.compile(r"^[a-p]{32}$")
ORIGIN = re.compile(r"^chrome-extension://([a-p]{32})/$")
COMMIT_LENGTH = 12  # host/src/build_id.rs
ACTIVE_STATES = ("queued", "running")
HYGIENE = Path(__file__).resolve().parent / "worktree-hygiene"
CHILD_ENV = {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}
HELLO_TIMEOUT = 30.0
STAGING = Path("target") / "deploy-staging"  # cargo --target-dir, relative to the repo
SELF = Path("scripts") / "dev" / "deploy-live"  # this script, relative to the repo
STATE_FILE = "deploy-live-state.json"  # in the git dir, so never committed or dirty
NODE_VERSION = "24.14.0"  # pinned by CI; supports direct TypeScript imports
SHA = re.compile(r"^[0-9a-f]{7,40}$")
# --drain: the service refuses new runs while this file in its support dir
# names a time still to come (host/src/service/drain.rs, which honours at
# most DRAIN_MAX seconds from the file's own mtime, so a marker a killed
# deploy left behind cannot pause runs for long).
DRAIN_FILE = "deploy-drain.json"
DRAIN_TIMEOUT = 600  # default --drain-timeout, seconds
DRAIN_MAX = 3600  # the service's own cap, and the largest --drain-timeout
DRAIN_GRACE = 300  # pause kept past the wait for publish, register and hello
DRAIN_POLL = 5  # seconds between run scans while draining
DRAIN_TIMEOUT_MAX = DRAIN_MAX - DRAIN_GRACE  # so the pause lasts through the publish
# The host's record of the extension build Chrome last said hello with
# (LOADED_EXTENSION_FILE in host/src/loaded_extension.rs).
LOADED_FILE = "loaded-extension.json"
LOADED_EXIT = {"loaded": 0, "pending reload": 3, "unavailable": 4}  # --loaded's exit codes
LS_REMOTE_TIMEOUT = 30.0  # seconds; git ls-remote is read-only, so it never prompts
# A deploy killed by one of these still runs main's finally (lifting the
# drain pause) and exits 128 + the signal number; Ctrl-C (SIGINT) already does.
# Windows has no SIGHUP, and its CI imports this file to run the tests.
TRAPPED_SIGNALS = tuple(getattr(signal, name) for name in ("SIGTERM", "SIGHUP")
                        if hasattr(signal, name))


class Signalled(BaseException):
    """SIGTERM or SIGHUP arrived; raised from the handler so cleanup runs."""

    def __init__(self, signum: int):
        super().__init__(signum)
        self.signum = signum


def _raise_signalled(signum, _frame):
    raise Signalled(signum)


def trap_signals() -> dict:
    """Make SIGTERM and SIGHUP raise Signalled; return the old handlers (none
    off the main thread, where Python cannot set them)."""
    if threading.current_thread() is not threading.main_thread():
        return {}
    return {sig: signal.signal(sig, _raise_signalled) for sig in TRAPPED_SIGNALS}


def restore_signals(old: dict) -> None:
    for sig, handler in old.items():
        signal.signal(sig, handler)


def honours_drain(binary: Path) -> bool:
    """Whether the live binary (the build the service runs) knows the pause
    marker: a build from before --drain existed ignores it, so a run could
    still start, and be ended, between the last scan and the restart. No
    binary means no service to drain."""
    try:
        return DRAIN_FILE.encode() in binary.read_bytes()
    except FileNotFoundError:
        return True
    except OSError:
        return False


def check_node(runner: Runner, repo: Path) -> str:
    """Verify the Node on PATH can run the TypeScript entry used by the build."""
    version = runner(["node", "--version"], cwd=repo)
    found = version.text.strip() if version.returncode == 0 else "unavailable"
    help_text = (f"select Node {NODE_VERSION} (for nvm: nvm install {NODE_VERSION} && "
                 f"nvm use {NODE_VERSION}), then rerun deploy-live")
    if version.returncode != 0:
        raise DeployError(f"Node preflight failed: {found}; {help_text}")
    probe = runner(["node", "--input-type=module", "-e",
                    "import('./extension/brand.ts')"], cwd=repo)
    if probe.returncode != 0:
        detail = probe.err.strip() or probe.text.strip() or f"exit {probe.returncode}"
        raise DeployError(f"Node preflight failed under {found}: TypeScript import: "
                          f"{detail}; {help_text}")
    return found


class DeployError(RuntimeError):
    """A step failed; the message says which and why."""


@dataclass
class Result:
    returncode: int
    stdout: bytes = b""
    stderr: bytes = b""

    @property
    def text(self) -> str:
        return self.stdout.decode("utf-8", "replace")

    @property
    def err(self) -> str:
        return self.stderr.decode("utf-8", "replace").strip()


# runner(argv, *, cwd, input=None, stream=False, timeout=None, env=None) -> Result.
# stream=True lets a long build print straight to the terminal; env adds to
# CHILD_ENV for this one call.
Runner = Callable[..., Result]


def system_runner(argv, *, cwd, input=None, stream=False, timeout=None, env=None) -> Result:
    child_env = {**CHILD_ENV, **(env or {})}
    try:
        if stream:
            proc = subprocess.run(argv, cwd=cwd, env=child_env, timeout=timeout)
            return Result(proc.returncode)
        # A captured call has no terminal to answer from, so it gets no stdin.
        proc = subprocess.run(argv, cwd=cwd, env=child_env, input=input, capture_output=True,
                              stdin=subprocess.DEVNULL if input is None else None,
                              timeout=timeout)
        return Result(proc.returncode, proc.stdout, proc.stderr)
    except FileNotFoundError as exc:
        return Result(127, b"", str(exc).encode())
    except subprocess.TimeoutExpired:
        return Result(124, b"", f"timed out after {timeout}s".encode())


