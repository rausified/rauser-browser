{
  "name": "brauser",
  "private": true,
  "version": "0.0.0",
  "description": "Development tooling for the Brauser browser extension and shared protocol",
  "scripts": {
    "build:extension": "node extension/build.mjs",
    "test:extension": "node --test extension/tests/*.test.mjs extension/tests/panel/*.test.mjs",
    "test:markdown-neutralizer": "node scripts/check-markdown-neutralizer.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:dev-tools": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "gate:adapter": "node scripts/gate-adapter.mjs",
    "gen:starters": "node scripts/generate-starters.mjs",
    "new:starter": "node scripts/new-starter.mjs",
    "test:adapter-diff": "node scripts/adapter-templates-diff.mjs",
    "logs": "node scripts/brauser-logs.mjs",
    "smoke:macos": "node scripts/smoke-macos.mjs",
    "smoke:macos:headless": "node scripts/smoke-macos.mjs --headless",
    "probe:m15a": "node scripts/probe-m15a.mjs",
    "test:queue": "python3 -m unittest discover -s scripts/tests && python3 scripts/check_queue_consistency.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:a11y": "node --test --test-isolation=none extension/tests/a11y/fixture.test.mjs extension/tests/a11y/pages.test.mjs extension/tests/a11y/keyboard.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "axe-core": "4.14.0",
    "eslint": "10.11.0",
    "markdown-it": "15.0.3",
    "marked": "18.1.2",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0"
  }
}
