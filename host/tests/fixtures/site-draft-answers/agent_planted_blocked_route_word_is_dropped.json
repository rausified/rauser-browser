        {
          "path": "/invitation/{n:int}"
        },
        {
          "path": "/callback/{n:int}"
        },
        {
          "path": "/authorize/{n:int}"
        },
        {
          "path": "/sso/{n:int}"
        },
        {
          "path": "/saml/{n:int}"
        },
        {
          "path": "/join/{n:int}"
        },
        {
          "path": "/activate/{n:int}"
        },
        {
          "path": "/activation/{n:int}"
        },
        {
          "path": "/verification/{n:int}"
        },
        {
          "path": "/tools/(docs|share)/{n:int}"
        }
