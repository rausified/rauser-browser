{
  "adapters": [
    {
      "type": "tools.docs",
      "origin": "https://tools.example.com",
      "match": [
        {
          "path": "/docs/{n:int}"
        }
      ],
      "id": "tools.docs:{host}/{n}"
    },
    {
      "type": "tools.view",
      "origin": "https://tools.example.com",
      "match": [
        {
          "path": "/view",
          "query": {
            "sig": "{h:hex(32)}"
          }
        }
      ],
      "id": "tools.view:{host}/{h}"
    },
    {
      "type": "tools.cb",
      "origin": "https://tools.example.com",
      "match": [
        {
          "path": "/cb",
          "query": {
            "code": "{t:token(1,128)}"
          }
        }
      ],
      "id": "tools.cb:{host}/{t}"
    },
    {
      "type": "tools.files",
      "origin": "https://tools.example.com",
      "match": [
        {
          "path": "/files/{_}",
          "query": {
            "token": "{t:token(1,128)}"
          }
        }
      ],
      "id": "tools.files:{host}/{t}"
    }
  ]
}
